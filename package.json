  },
  "engines": {
    "node": ">=18"
  },
  "keywords": [
    "arkts",
    "harmonyos",
    "鸿蒙",
    "json2ts",
    "cli"
  ],
  "devDependencies": {
    "@types/node": "^22.10.0",
    "typescript": "^5.7.0"
  }
}
