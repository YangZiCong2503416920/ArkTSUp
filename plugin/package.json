{
  "name": "arktsup-vscode",
  "displayName": "ArkTSUp — HarmonyOS ArkTS 提效工具",
  "description": "ArkTS 检查(严格语法)与 JSON→类型 生成的 VS Code 插件，基于 arktsup CLI",
  "version": "0.2.1",
  "publisher": "yanceecha",
  "license": "MIT",
  "icon": "icon.png",
  "galleryBanner": {
    "color": "#0F2A43",
    "theme": "dark"
  },
  "badges": [
    {
      "url": "https://img.shields.io/visual-studio-marketplace/v/yanceecha.arktsup-vscode",
      "href": "https://marketplace.visualstudio.com/items?itemName=yanceecha.arktsup-vscode",
      "description": "Marketplace version"
    },
    {
      "url": "https://img.shields.io/visual-studio-marketplace/i/yanceecha.arktsup-vscode",
      "href": "https://marketplace.visualstudio.com/items?itemName=yanceecha.arktsup-vscode",
      "description": "Marketplace installs"
    },
    {
      "url": "https://img.shields.io/visual-studio-marketplace/d/yanceecha.arktsup-vscode",
      "href": "https://marketplace.visualstudio.com/items?itemName=yanceecha.arktsup-vscode",
      "description": "Marketplace downloads"
    },
    {
      "url": "https://img.shields.io/visual-studio-marketplace/r/yanceecha.arktsup-vscode",
      "href": "https://marketplace.visualstudio.com/items?itemName=yanceecha.arktsup-vscode",
      "description": "Marketplace rating"
    }
  ],
  "engines": {
    "vscode": "^1.85.0"
  },
  "categories": [
    "Linters",
    "Other"
  ],
  "keywords": [
    "arkts",
    "harmonyos",
    "鸿蒙",
    "lint"
  ],
  "activationEvents": [
    "workspaceContains:**/*.ets",
    "onCommand:arktsup.checkWorkspace",
    "onCommand:arktsup.checkActiveFile",
    "onCommand:arktsup.json2tsFromClipboard",
    "onCommand:arktsup.migrate",
    "onCommand:arktsup.resourceCheck"
  ],
  "main": "./out/extension.js",
  "contributes": {
    "commands": [
      {
        "command": "arktsup.checkWorkspace",
        "title": "ArkTSUp: 检查工程（ArkTS 严格语法）"
      },
      {
        "command": "arktsup.checkActiveFile",
        "title": "ArkTSUp: 检查当前文件"
      },
      {
        "command": "arktsup.json2tsFromClipboard",
        "title": "ArkTSUp: 从剪贴板 JSON 生成 ArkTS 类型"
      },
      {
        "command": "arktsup.migrate",
        "title": "ArkTSUp: 迁移废弃 API（@ohos.* → @kit.*）"
      },
      {
        "command": "arktsup.resourceCheck",
        "title": "ArkTSUp: 检查资源引用"
      }
    ],
    "configuration": {
      "title": "ArkTSUp",
      "properties": {
        "arktsup.cliPath": {
          "type": "string",
          "default": "",
          "description": "arktsup CLI 的绝对路径（默认自动查找项目内 dist/src/cli.js）"
        },
        "arktsup.checkOnSave": {
          "type": "boolean",
          "default": true,
          "description": "保存 .ets 文件时自动运行检查（防抖 500ms）"
        }
      }
    }
  },
  "scripts": {
    "build": "node scripts/clean.js && tsc -p ./ && node scripts/copy-lib.js",
    "package": "npm run build && npx --yes @vscode/vsce package --out arktsup-vscode.vsix"
  },
  "dependencies": {
    "json5": "^2.2.3",
    "typescript": "^5.7.0"
  },
  "devDependencies": {
    "@types/node": "^22.0.0",
    "@types/vscode": "^1.85.0"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/YangZiCong2503416920/ArkTSUp.git"
  },
  "homepage": "https://github.com/YangZiCong2503416920/ArkTSUp",
  "bugs": {
    "url": "https://github.com/YangZiCong2503416920/ArkTSUp/issues"
  }
}
